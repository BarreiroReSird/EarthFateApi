# Server Port
PORT=3000

# Supabase Database Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# JWT Authentication (In production, must be a long, random secret key)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Password Hashing Cost (Minimum 10; Recommended 12 in Production)
BCRYPT_SALT_ROUNDS=10

# CORS Security (Allowed origins comma-separated, e.g. http://localhost:4200)
CORS_ORIGIN=*

# Rate Limiting (requests per 15 minute window)
# NOTE: the in-memory store is per process, so use a shared store when running
# more than one instance (see TASKS.md)
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=10

# How many reverse proxies sit in front of the API. Set this to 1 on Heroku,
# Render, Railway, Cloudflare or nginx, otherwise every visitor shares one
# rate-limit bucket. Leave it false when the app is exposed directly.
# NEVER set it to true: that lets a client fake its own IP and skip the limits.
TRUST_PROXY=false

# HSTS also covers subdomains. Only enable once every subdomain is HTTPS,
# otherwise you lock yourself out of the ones that are not.
HSTS_INCLUDE_SUBDOMAINS=false

