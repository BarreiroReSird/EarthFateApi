# Server Port
PORT=3000

# Google Sheets Database Configuration
# See SETUP-GOOGLE-SHEETS.md for how to create these in five minutes.
# The id is the part of the spreadsheet URL between /d/ and /edit.
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# The service account has access to the spreadsheet. Copy client_email and
# private_key out of the key file, keeping the \n escapes as they are.
# NEVER commit the key file: .env is ignored, the .json is not.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternative to the two lines above: paste the whole key file on one line.
# When this is set it wins over GOOGLE_SERVICE_ACCOUNT_EMAIL/GOOGLE_PRIVATE_KEY.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# JWT Authentication (In production, must be a long, random secret key)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Password Hashing Cost (Minimum 10; Recommended 12 in Production)
BCRYPT_SALT_ROUNDS=10

# CORS Security (Allowed origins comma-separated, e.g. http://localhost:4200)
# This is the Angular dev server. List the real origins in production: the API
# refuses to start there with a wildcard, so any site could call it.
CORS_ORIGIN=http://localhost:4200

# Rate Limiting (requests per 15 minute window)
# NOTE: the in-memory store is per process, so use a shared store when running
# more than one instance (see TASKS.md)
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=10

# How many reverse proxies sit in front of the API. Set this to 1 on Heroku,
# Render, Railway, Cloudflare or nginx, otherwise every visitor shares one
# rate-limit bucket. Leave it false when the app is exposed directly.
# NEVER set it to true: that lets a client fake its own IP and skip the limits.
TRUST_PROXY=false

# HSTS also covers subdomains. Only enable once every subdomain is HTTPS,
# otherwise you lock yourself out of the ones that are not.
HSTS_INCLUDE_SUBDOMAINS=false
# Preload asks browsers to hardcode HTTPS for this domain. Near-impossible to
# undo once a browser has it, so leave it off unless the domain is yours
# permanently and every host under it is on HTTPS.
HSTS_PRELOAD=false

