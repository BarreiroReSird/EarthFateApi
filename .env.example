# Server Port
PORT=3000

# Supabase Database Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# JWT Authentication (In production, must be a long, random secret key)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Password Hashing Cost (Minimum 10; Recommended 12 in Production)
BCRYPT_SALT_ROUNDS=10

# CORS Security (Allowed origins comma-separated, e.g. http://localhost:4200)
CORS_ORIGIN=*

